{
  "rewrites": [
    { "source": "/analysis", "destination": "/index.html" },
    { "source": "/chart", "destination": "/index.html" },
    { "source": "/chart/**", "destination": "/index.html" },
    { "source": "/quick-review", "destination": "/index.html" },
    { "source": "/watchlist", "destination": "/index.html" },
    { "source": "/scan", "destination": "/index.html" },
    { "source": "/stock-detail/**", "destination": "/index.html" },
    { "source": "/trades", "destination": "/index.html" },
    { "source": "/trades/**", "destination": "/index.html" },
    { "source": "/journal", "destination": "/index.html" },
    { "source": "/journal/**", "destination": "/index.html" },
    { "source": "/risk-management", "destination": "/index.html" },
    { "source": "/recommendations", "destination": "/index.html" },
    { "source": "/recommendations/**", "destination": "/index.html" },
    { "source": "/investments", "destination": "/index.html" },
    { "source": "/investments/**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
